{
  "manifest_version": 3,
  "name": "SnapList — Facebook Marketplace Autofill",
  "version": "0.1.0",
  "description": "One-click auto-fill of Facebook Marketplace listings from your SnapList drafts.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapList"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace/create/*",
        "https://www.facebook.com/marketplace/*/create*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
