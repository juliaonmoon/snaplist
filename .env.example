# Database
DATABASE_URL=postgresql+asyncpg://snaplist:password@localhost:5432/snaplist

# Groq (free tier — get key at console.groq.com, no credit card needed)
GROQ_API_KEY=gsk_...

# eBay Developer API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_TOKEN=
EBAY_SANDBOX=true

# Etsy API (optional)
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_ACCESS_TOKEN=

# SendGrid (email notifications)
SENDGRID_API_KEY=SG....
NOTIFICATION_EMAIL=juliaonmoon@gmail.com
FROM_EMAIL=noreply@snaplist.app

# Pushover (optional push notifications)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# App
SECRET_KEY=change-me-to-a-random-secret
ENVIRONMENT=development
UPLOAD_DIR=uploads

# Region — controls eBay marketplace, currency, classifieds platform, URLs
COUNTRY=CA          # CA, US, UK, AU, DE, FR
CURRENCY=CAD        # CAD, USD, GBP, AUD, EUR
EBAY_MARKETPLACE_ID=EBAY_CA
CITY=Surrey
REGION=BC
