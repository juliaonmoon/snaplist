# Firebase — required for Google + Facebook login
# Create a project at https://console.firebase.google.com
# Enable Authentication → Sign-in method → Google and Facebook
# Then: Project settings → Your apps → Add web app → copy the config below
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Facebook Login extra step:
# Go to https://developers.facebook.com → My Apps → Create App
# Add product: Facebook Login → set OAuth redirect URI to:
# https://your-project-id.firebaseapp.com/__/auth/handler
